// res/hotrainy.rc — 可执行文件的资源
//
// 为什么需要这个文件：
//   任务栏按 AUMID 给同一个 exe 的所有窗口归一个按钮，
//   按钮图标来自**可执行文件的图标资源**，不是窗口的 WM_GETICON。
//
//   之前 hotrainy.exe 没有图标资源，任务栏就显示那个通用的
//   "文档"图标 —— 不管我们在窗口上设多少种图标都没用。
//
//   实测佐证：
//     · 窗口的 WM_GETICON / 类图标都返回正确的 H（probe_win_icon 验过）
//     · 隐藏窗口后任务栏图标不消失（说明它不跟着窗口走）
//
// IDI_MAIN 这个名字只是内部标识，用什么名字都行。
// 1 是图标组的序号 —— 组里第一个图标就是 exe 的主图标，
// 资源管理器、任务栏、Alt+Tab 默认都用它。

#include <windows.h>

IDI_MAIN ICON "hotrainy.ico"
